{
  "name": "@dania/commerce",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/index-worker.ts",
    "dev:dashboard": "vite --host 0.0.0.0",
    "build": "tsc -p tsconfig.json && vite build",
    "start": "node dist/index.js",
    "start:worker": "node dist/index-worker.js",
    "migration:generate": "vendure migrate --generate",
    "migration:run": "vendure migrate --run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "11.2.1",
    "@nestjs/core": "11.2.1",
    "@nestjs/graphql": "13.1.0",
    "@nestjs/platform-express": "11.2.1",
    "@vendure/asset-server-plugin": "3.7.2",
    "@vendure/core": "3.7.2",
    "@vendure/dashboard": "3.7.2",
    "@vendure/email-plugin": "3.7.2",
    "@vendure/harden-plugin": "3.7.2",
    "dotenv": "17.2.2",
    "graphql": "16.11.0",
    "graphql-tag": "2.12.6",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "typeorm": "0.3.26"
  },
  "devDependencies": {
    "@types/node": "22.18.3",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vite": "7.1.5"
  }
}
