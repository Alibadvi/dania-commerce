FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
COPY scripts ./scripts
RUN npm run install:ci
COPY . .
RUN npm run build

FROM node:22-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production PORT=3001
COPY --from=build /app ./
USER node
EXPOSE 3001
CMD ["npm", "start", "--", "--host", "0.0.0.0", "--port", "3001"]
