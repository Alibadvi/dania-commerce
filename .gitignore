# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/commerce/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!/commerce/.env.example

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/commerce/dist/
/commerce/src/gql/
/commerce/static/assets/*
!/commerce/static/assets/.gitkeep
/commerce/static/email/test-emails/*
!/commerce/static/email/test-emails/.gitkeep
/.wrangler/
/.sites-runtime/
/outputs/
/work/
